+
+// Filter lists are plain text and large; 32 MB is far above the biggest list in
+// circulation and far below anything that would matter to memory. The cap is
+// not about disk - it is that SimpleURLLoader buffers the body in memory, so an
+// unbounded download of an attacker-chosen URL is an unbounded allocation.
+constexpr size_t kMaxListBytes = 32u * 1024u * 1024u;
+
+// Lists move a few times a day at most, and every refresh costs a full
+// re-index. Daily keeps rules current at the granularity that matters for
+// blocking without spending the user's battery on it.
+constexpr base::TimeDelta kUpdateInterval = base::Hours(24);
+
+// Long enough that a slow mirror still succeeds, short enough that a hung
+// connection does not hold the update cycle open indefinitely.
+constexpr base::TimeDelta kFetchTimeout = base::Seconds(60);
+
+std::string HashOf(std::string_view text) {
+  return base::HexEncode(base::SHA1Hash(base::as_byte_span(text)));
+}
+
+// Reads the cached copies of every enabled list, parses them, and writes one
+// merged unindexed ruleset. Runs on a blocking sequence: parsing three lists is
+// hundreds of thousands of lines and must never touch the UI thread.
+//
+// Parsing happens in the browser process rather than a utility process. That is
+// a deliberate, bounded risk: RuleParser is pure string handling over text,
+// allocates no attacker-sized buffers, and Chromium fuzzes it continuously
+// (tools/rule_parser/rule_parser_fuzzer.cc). It is still privileged code
+// reading remote input, so the parse is confined to this one function with a
+// plain in/out contract - moving it behind a mojo interface later is a change
+// to this function's body, not to the design around it.
+AeriumBlockerService::RebuildResult BuildRuleset(
+    std::vector<std::pair<std::string, base::FilePath>> enabled,
+    base::FilePath out_path) {
+  AeriumBlockerService::RebuildResult result;
+  result.unindexed_path = out_path;
+
+  base::File out(out_path, base::File::FLAG_CREATE_ALWAYS |
+                               base::File::FLAG_WRITE);
+  if (!out.IsValid()) {
+    LOG(ERROR) << "[aerium] cannot open " << out_path << " for the ruleset";
+    return result;
+  }
+
+  subresource_filter::CopyingFileOutputStream copying_stream(std::move(out));
+  google::protobuf::io::CopyingOutputStreamAdaptor adaptor(&copying_stream);
+  subresource_filter::UnindexedRulesetWriter writer(&adaptor);
+
+  // The content version has to change whenever the ruleset's meaning changes
+  // and stay put otherwise, because RulesetService skips the whole index-and-
+  // publish cycle when it is unchanged. Built from each enabled list's URL and
+  // the hash of its bytes, so disabling a list, adding one, or a list changing
+  // upstream all move it - and a no-op refresh does not.
+  std::string version_material;
+
+  for (const auto& [url, path] : enabled) {
+    std::string text;
+    if (!base::ReadFileToStringWithMaxSize(path, &text, kMaxListBytes)) {
+      result.errors[url] = "No downloaded copy of this list yet.";
+      continue;
+    }
+    version_material += url;
+    version_material += HashOf(text);
+
+    int accepted = 0;
+    int rejected = 0;
+    subresource_filter::RuleParser parser;
+    for (std::string_view line : base::SplitStringPiece(
+             text, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      switch (parser.Parse(line)) {
+        case url_pattern_index::proto::RULE_TYPE_URL:
+          if (writer.AddUrlRule(parser.url_rule().ToProtobuf())) {
+            ++accepted;
+          } else {
+            ++rejected;
+          }
+          break;
+        case url_pattern_index::proto::RULE_TYPE_CSS:
+          if (writer.AddStyleRule(parser.style_rule().ToProtobuf())) {
+            ++accepted;
+          } else {
+            ++rejected;
+          }
+          break;
+        default:
+          // Comments, blank lines and metadata headers are the bulk of any
+          // list and are not failures. Neither is a rule using a syntax
+          // Chromium's matcher has no representation for - EasyList carries
+          // features no engine implements all of - so these are counted
+          // separately and not reported as an error.
+          ++rejected;
+          break;
+      }
+    }
+    result.rule_counts[url] = accepted;
+    if (accepted == 0) {
+      // Zero usable rules from a non-empty file almost always means the fetch
+      // returned something that is not a filter list - a captive portal page,
+      // an HTML 404. Saying so beats a row that reads "0 rules" and looks like
+      // a list with nothing left to block.
+      result.errors[url] =
+          "No usable rules found - check that the URL serves a filter list.";
+    }
+  }
+
+  if (!writer.Finish() || !adaptor.Flush()) {
+    LOG(ERROR) << "[aerium] failed writing the merged ruleset";
+    return result;
+  }
+
+  result.content_version = HashOf(version_material);
+  // An empty version would be rejected by RulesetService, and it is also the
+  // honest signal that there is nothing to publish: every enabled list failed
+  // to read, or none is enabled.
+  result.ok = !result.content_version.empty() && !enabled.empty();
+  return result;
+}
