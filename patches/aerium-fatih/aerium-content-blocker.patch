+AeriumBlockerService::RebuildResult::RebuildResult() = default;
+AeriumBlockerService::RebuildResult::RebuildResult(RebuildResult&&) = default;
+AeriumBlockerService::RebuildResult&
+AeriumBlockerService::RebuildResult::operator=(RebuildResult&&) = default;
+AeriumBlockerService::RebuildResult::~RebuildResult() = default;
