+AeriumBlockerService::AeriumBlockerService(
+    PrefService* local_state,
+    const base::FilePath& user_data_dir,
+    scoped_refptr<network::SharedURLLoaderFactory> url_loader_factory)
+    : local_state_(local_state),
+      cache_dir_(user_data_dir.AppendASCII("Aerium Filter Lists")),
+      url_loader_factory_(std::move(url_loader_factory)) {
+  // Deliberately Chrome's existing RulesetService rather than a second one.
+  //
+  // subresource_filter's renderer half is singular: one UnverifiedRulesetDealer
+  // per render process, fed by one RulesetPublisher. RulesetConfig allows
+  // several services to coexist on disk, but nothing in 152 wires a second one
+  // through to the renderers - Chrome ships exactly one ruleset and there is no
+  // in-tree example of a second, so standing one up would mean maintaining a
+  // parallel publish path against upstream forever.
+  //
+  // Reusing the existing service costs nothing here. That slot holds Safe
+  // Browsing's ad filter upstream, and ungoogled-chromium removes Safe
+  // Browsing, so in an Aerium build it is never populated at all. This fills an
+  // empty slot rather than displacing a working feature, and every downstream
+  // piece - the throttle, the memory-mapped dealer, cosmetic filtering - works
+  // unmodified.
+
+  pref_change_registrar_.Init(local_state_);
+  pref_change_registrar_.Add(
+      kAeriumBlockerEnabled,
+      base::BindRepeating(&AeriumBlockerService::OnEnabledChanged,
+                          weak_factory_.GetWeakPtr()));
+  pref_change_registrar_.Add(
+      kAeriumBlockerAutoUpdate,
+      base::BindRepeating(&AeriumBlockerService::ScheduleNextUpdate,
+                          weak_factory_.GetWeakPtr()));
+
+  // Tell the throttle whether to force activation before the first navigation
+  // can reach it. Nothing is blocked until a ruleset is published regardless,
+  // but leaving this stale would mean the first page after a restart is
+  // filtered according to the previous run's setting.
+  subresource_filter::SetAeriumBlockingEnabled(IsEnabled());
+
+  // Rebuild from whatever is already cached before doing anything on the
+  // network, so a launch with no connection still blocks with the lists from
+  // last time rather than with nothing.
+  RebuildRuleset();
+  ScheduleNextUpdate();
+}
+
+AeriumBlockerService::~AeriumBlockerService() = default;
+
+void AeriumBlockerService::AddObserver(Observer* observer) {
+  observers_.AddObserver(observer);
+}
+
+void AeriumBlockerService::RemoveObserver(Observer* observer) {
+  observers_.RemoveObserver(observer);
+}
+
+bool AeriumBlockerService::IsEnabled() const {
+  return local_state_->GetBoolean(kAeriumBlockerEnabled);
+}
+
+base::FilePath AeriumBlockerService::CacheFilePathFor(
+    const std::string& url) const {
+  // Named by hash rather than by anything derived from the URL text: list URLs
+  // contain characters that are not portable in filenames, and a hash is the
+  // same length on every platform.
+  return cache_dir_.AppendASCII(HashOf(url) + ".txt");
+}
+
+void AeriumBlockerService::OnEnabledChanged() {
+  subresource_filter::SetAeriumBlockingEnabled(IsEnabled());
+  // Belt and braces: the switch above stops new navigations activating, and
+  // this rebuild empties the ruleset behind it. Either alone would do, but the
+  // first only affects navigations that have not started and the second only
+  // takes effect once indexing finishes, so doing both closes the window
+  // between them in which a page could still be filtered after the user turned
+  // blocking off.
+  RebuildRuleset();
+  ScheduleNextUpdate();
+}
+
+bool AeriumBlockerService::AddCustomList(const std::string& url,
+                                         const std::string& title) {
+  const GURL parsed(url);
+  // https only. A filter list fetched over http can be rewritten in flight by
+  // anyone on the path, and a rewritten filter list is an instruction to the
+  // browser about what to block - or, through allowlist rules, what to stop
+  // blocking.
+  if (!parsed.is_valid() || !parsed.SchemeIs("https")) {
+    return false;
+  }
+
+  std::vector<FilterList> lists = GetLists(local_state_);
+  for (const FilterList& existing : lists) {
+    if (existing.url == url) {
+      return false;
+    }
+  }
+
+  FilterList added;
+  added.url = url;
+  added.title = title.empty() ? parsed.host() : title;
+  added.enabled = true;
+  added.builtin = false;
+  lists.push_back(std::move(added));
+  SetLists(local_state_, lists);
+
+  // Fetch immediately: a list that appears in Settings with no rules until
+  // tomorrow's refresh looks broken.
+  FetchList(lists.back());
+  return true;
+}
+
+bool AeriumBlockerService::RemoveCustomList(const std::string& url) {
+  std::vector<FilterList> lists = GetLists(local_state_);
+  const size_t before = lists.size();
+  std::erase_if(lists, [&url](const FilterList& list) {
+    return list.url == url && !list.builtin;
+  });
+  if (lists.size() == before) {
+    return false;
+  }
+  SetLists(local_state_, lists);
+
+  // Drop the cached text too. Leaving it would quietly reinstate the list if
+  // the same URL were added again, with content the user believes they removed.
+  base::ThreadPool::PostTask(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(base::GetDeleteFileCallback(), CacheFilePathFor(url)));
+
+  RebuildRuleset();
+  return true;
+}
+
+void AeriumBlockerService::SetListEnabled(const std::string& url,
+                                          bool enabled) {
+  std::vector<FilterList> lists = GetLists(local_state_);
+  bool changed = false;
+  for (FilterList& list : lists) {
+    if (list.url == url && list.enabled != enabled) {
+      list.enabled = enabled;
+      changed = true;
+    }
+  }
+  if (!changed) {
+    return;
+  }
+  SetLists(local_state_, lists);
+  RebuildRuleset();
+}
+
+void AeriumBlockerService::ScheduleNextUpdate() {
+  update_timer_.Stop();
+  if (!IsEnabled() || !local_state_->GetBoolean(kAeriumBlockerAutoUpdate)) {
+    return;
+  }
+  const base::Time last = local_state_->GetTime(kAeriumBlockerLastUpdate);
+  const base::TimeDelta since = base::Time::Now() - last;
+  // A browser closed for a fortnight refreshes at launch instead of waiting
+  // out a fresh interval; clamping at zero also covers a clock moved backwards.
+  const base::TimeDelta delay =
+      since >= kUpdateInterval ? base::TimeDelta() : kUpdateInterval - since;
+  update_timer_.Start(FROM_HERE, delay,
+                      base::BindOnce(&AeriumBlockerService::MaybeUpdateLists,
+                                     weak_factory_.GetWeakPtr()));
+}
+
+void AeriumBlockerService::MaybeUpdateLists() {
+  if (!IsEnabled() || !local_state_->GetBoolean(kAeriumBlockerAutoUpdate)) {
+    return;
+  }
+  UpdateListsNow();
+  ScheduleNextUpdate();
+}
+
+void AeriumBlockerService::UpdateListsNow() {
+  local_state_->SetTime(kAeriumBlockerLastUpdate, base::Time::Now());
+  for (const FilterList& list : GetLists(local_state_)) {
+    if (list.enabled) {
+      FetchList(list);
+    }
+  }
+}
+
+void AeriumBlockerService::FetchList(const FilterList& list) {
+  const GURL url(list.url);
+  if (!url.is_valid() || !url.SchemeIs("https")) {
+    return;
+  }
+
+  auto request = std::make_unique<network::ResourceRequest>();
+  request->url = url;
+  request->method = "GET";
+  // No cookies, no credentials, no referrer. A filter list is a public static
+  // file; sending anything that identifies the user would turn a privacy
+  // feature into a tracking vector, and the fetch happens on a schedule that
+  // makes it a reliable beacon if it carried identity.
+  request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+  request->referrer_policy = net::ReferrerPolicy::NO_REFERRER;
+
+  constexpr net::NetworkTrafficAnnotationTag kAnnotation =
+      net::DefineNetworkTrafficAnnotation("aerium_filter_list_update", R"(
+        semantics {
+          sender: "Aerium Content Blocker"
+          description:
+            "Downloads a content-blocking filter list so Aerium can block "
+            "advertising and tracking requests before they are sent."
+          trigger:
+            "Once a day while automatic updates are on, when the user presses "
+            "Update now, or when a new list is added."
+          data:
+            "None. The request carries no cookies, no credentials and no "
+            "referrer - only a GET for a public static file."
+          destination: WEBSITE
+        }
+        policy {
+          cookies_allowed: NO
+          setting:
+            "Disabled by turning off automatic updates, or by turning off "
+            "content blocking, in Settings > Privacy and security."
+          policy_exception_justification: "Not implemented."
+        })");
+
+  auto loader = network::SimpleURLLoader::Create(std::move(request),
+                                                 kAnnotation);
+  loader->SetTimeoutDuration(kFetchTimeout);
+  // Retries are worth it for a transient network failure but must not be
+  // unbounded; two attempts covers a flaky connection without hammering a
+  // list host that is down.
+  loader->SetRetryOptions(
+      2, network::SimpleURLLoader::RETRY_ON_NETWORK_CHANGE |
+             network::SimpleURLLoader::RETRY_ON_5XX);
+
+  network::SimpleURLLoader* raw_loader = loader.get();
+  loaders_[list.url] = std::move(loader);
+  raw_loader->DownloadToString(
+      url_loader_factory_.get(),
+      base::BindOnce(&AeriumBlockerService::OnListFetched,
+                     weak_factory_.GetWeakPtr(), list.url),
+      kMaxListBytes);
+}
+
+void AeriumBlockerService::OnListFetched(std::string url,
+                                         std::unique_ptr<std::string> body) {
+  auto it = loaders_.find(url);
+  const int net_error = it != loaders_.end() ? it->second->NetError() : 0;
+  loaders_.erase(url);
+
+  if (!body || body->empty()) {
+    std::vector<FilterList> lists = GetLists(local_state_);
+    for (FilterList& list : lists) {
+      if (list.url == url) {
+        list.error = "Download failed (" + base::NumberToString(net_error) +
+                     "). The previous copy is still in use.";
+      }
+    }
+    SetLists(local_state_, lists);
+    for (Observer& observer : observers_) {
+      observer.OnBlockerListsChanged();
+    }
+    return;
+  }
+
+  const std::string hash = HashOf(*body);
+  std::vector<FilterList> lists = GetLists(local_state_);
+  bool unchanged = false;
+  for (FilterList& list : lists) {
+    if (list.url != url) {
+      continue;
+    }
+    unchanged = (list.content_hash == hash);
+    list.content_hash = hash;
+    list.last_update = base::Time::Now();
+    list.error.clear();
+  }
+  SetLists(local_state_, lists);
+
+  if (unchanged) {
+    // Same bytes as last time. Writing the file again and re-indexing would
+    // produce a byte-identical ruleset for a few hundred milliseconds of CPU.
+    for (Observer& observer : observers_) {
+      observer.OnBlockerListsChanged();
+    }
+    return;
+  }
+
+  const base::FilePath path = CacheFilePathFor(url);
+  base::ThreadPool::PostTaskAndReply(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::BEST_EFFORT},
+      base::BindOnce(
+          [](base::FilePath dir, base::FilePath path, std::string text) {
+            base::CreateDirectory(dir);
+            // Written whole then moved into place would be better still, but
+            // a partial write here is caught downstream: the parse produces
+            // fewer rules, and the ruleset is only published after
+            // RulesetService verifies its checksum.
+            base::WriteFile(path, text);
+          },
+          cache_dir_, path, std::move(*body)),
+      base::BindOnce(&AeriumBlockerService::RebuildRuleset,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AeriumBlockerService::RebuildRuleset() {
+  if (rebuild_in_progress_) {
+    rebuild_queued_ = true;
+    return;
+  }
+  rebuild_in_progress_ = true;
+
+  std::vector<std::pair<std::string, base::FilePath>> enabled;
+  if (IsEnabled()) {
+    for (const FilterList& list : GetLists(local_state_)) {
+      if (list.enabled) {
+        enabled.emplace_back(list.url, CacheFilePathFor(list.url));
+      }
+    }
+  }
+
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+       base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+      base::BindOnce(&BuildRuleset, std::move(enabled),
+                     cache_dir_.AppendASCII("merged.unindexed")),
+      base::BindOnce(&AeriumBlockerService::OnRebuildComplete,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void AeriumBlockerService::OnRebuildComplete(RebuildResult result) {
+  rebuild_in_progress_ = false;
+
+  std::vector<FilterList> lists = GetLists(local_state_);
+  for (FilterList& list : lists) {
+    if (auto count = result.rule_counts.find(list.url);
+        count != result.rule_counts.end()) {
+      list.rule_count = count->second;
+    }
+    if (auto error = result.errors.find(list.url);
+        error != result.errors.end()) {
+      list.error = error->second;
+    } else if (list.enabled) {
+      list.error.clear();
+    }
+  }
+  SetLists(local_state_, lists);
+
+  subresource_filter::RulesetService* const service =
+      g_browser_process->subresource_filter_ruleset_service();
+  if (result.ok && service) {
+    subresource_filter::UnindexedRulesetInfo info;
+    info.content_version = result.content_version;
+    info.ruleset_path = result.unindexed_path;
+    // Indexing, checksum verification, versioned storage and publishing to
+    // every renderer all happen inside this call. If the file is malformed the
+    // existing ruleset stays live, which is why a failed rebuild is not a
+    // window with blocking switched off.
+    service->IndexAndStoreAndPublishRulesetIfNeeded(info);
+  }
+
+  for (Observer& observer : observers_) {
+    observer.OnBlockerListsChanged();
+  }
+
+  if (rebuild_queued_) {
+    rebuild_queued_ = false;
+    RebuildRuleset();
+  }
+}
