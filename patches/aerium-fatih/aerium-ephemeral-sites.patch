 void ChromeBrowsingDataLifetimeManager::Shutdown() {
+#if !BUILDFLAG(IS_ANDROID)
+  // Ordered before the weak-pointer invalidation below: dropping the
+  // observations first means no further AeriumClearClosedEphemeralSites() can
+  // be posted, and any already posted is cancelled by the invalidation.
+  aerium_tab_strip_observations_.RemoveAllObservations();
+  if (auto* collection = GlobalBrowserCollection::GetInstance()) {
+    collection->RemoveObserver(this);
+  }
+#endif
   pref_change_registrar_.RemoveAll();
   weak_ptr_factory_.InvalidateWeakPtrs();
