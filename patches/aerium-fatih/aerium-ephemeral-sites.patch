+#if !BUILDFLAG(IS_ANDROID)
+void ChromeBrowsingDataLifetimeManager::AeriumObserveExistingBrowsers() {
+  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+      [this](BrowserWindowInterface* browser) {
+        if (browser->GetProfile() == profile_) {
+          TabStripModel* const model = browser->GetTabStripModel();
+          if (model &&
+              !aerium_tab_strip_observations_.IsObservingSource(model)) {
+            aerium_tab_strip_observations_.AddObservation(model);
+          }
+        }
+        return true;
+      });
+}
+
+void ChromeBrowsingDataLifetimeManager::OnBrowserCreated(
+    BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile() != profile_) {
+    return;
+  }
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (model && !aerium_tab_strip_observations_.IsObservingSource(model)) {
+    aerium_tab_strip_observations_.AddObservation(model);
+  }
+}
+
+void ChromeBrowsingDataLifetimeManager::OnBrowserClosed(
+    BrowserWindowInterface* browser) {
+  if (!browser || browser->GetProfile() != profile_) {
+    return;
+  }
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (model && aerium_tab_strip_observations_.IsObservingSource(model)) {
+    aerium_tab_strip_observations_.RemoveObservation(model);
+  }
+  // A closing window takes every tab in it with it, so a site can stop being
+  // open without any single tab removal having been the one that did it.
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ChromeBrowsingDataLifetimeManager::AeriumClearClosedEphemeralSites,
+          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ChromeBrowsingDataLifetimeManager::OnTabStripModelChanged(
+    TabStripModel* tab_strip_model,
+    const TabStripModelChange& change,
+    const TabStripSelectionChange& selection) {
+  if (change.type() != TabStripModelChange::kRemoved) {
+    return;
+  }
+  // Posted, not immediate: at this point the removed tab can still be reachable
+  // from the model, so an immediate walk would see the site as still open and
+  // clear nothing.
+  content::GetUIThreadTaskRunner({})->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          &ChromeBrowsingDataLifetimeManager::AeriumClearClosedEphemeralSites,
+          weak_ptr_factory_.GetWeakPtr()));
+}
+
+void ChromeBrowsingDataLifetimeManager::AeriumClearClosedEphemeralSites() {
+  const std::set<std::string> ephemeral =
+      AeriumEphemeralDomains(profile_->GetPrefs());
+  if (ephemeral.empty()) {
+    return;
+  }
+  const std::set<std::string> still_open =
+      AeriumOpenRegistrableDomains(profile_);
+
+  auto filter = content::BrowsingDataFilterBuilder::Create(
+      content::BrowsingDataFilterBuilder::Mode::kDelete);
+  bool any = false;
+  for (const std::string& domain : ephemeral) {
+    if (still_open.count(domain)) {
+      continue;
+    }
+    filter->AddRegisterableDomain(domain);
+    any = true;
+  }
+  if (!any) {
+    return;
+  }
+
+  // Cookies and storage only. Both are in FILTERABLE_DATA_TYPES; anything else
+  // would trip the CHECK in
+  // ChromeBrowsingDataRemoverDelegate::RemoveEmbedderData(), which aborts
+  // release builds rather than merely failing the deletion.
+  //
+  // The observer is not optional - RemoveWithFilterAndReply() calls into it
+  // unconditionally - but no keep-alive variant is needed here: unlike the
+  // on-exit path this runs while the browser is plainly still up.
+  content::BrowsingDataRemover* const remover =
+      profile_->GetBrowsingDataRemover();
+  remover->RemoveWithFilterAndReply(
+      base::Time::Min(), base::Time::Max(),
+      content::BrowsingDataRemover::DATA_TYPE_COOKIES |
+          content::BrowsingDataRemover::DATA_TYPE_DOM_STORAGE,
+      content::BrowsingDataRemover::ORIGIN_TYPE_UNPROTECTED_WEB,
+      std::move(filter),
+      testing_data_remover_observer_
+          ? testing_data_remover_observer_.get()
+          : BrowsingDataRemoverObserver::Create(
+                remover, /*filterable_deletion=*/true, profile_));
+}
